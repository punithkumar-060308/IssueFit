APP_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=issuefit

GITHUB_TOKEN=your_github_token_here
FRONTEND_ORIGIN=http://localhost:5173
CACHE_TTL_SECONDS=300
MAX_GITHUB_ITEMS=300

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_CONNECT_REDIRECT_URI=http://localhost:8000/auth/github/connect/callback

SESSION_SECRET=your_long_random_session_secret
TOKEN_ENCRYPTION_KEY=your_token_encryption_key
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# AI Issue Breakdown Configuration
LLM_PROVIDER=gemini # "gemini", "openai", or "mock"
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-4-26b-a4b-it
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_REQUEST_TIMEOUT_SECONDS=45
BREAKDOWN_CACHE_TTL_SECONDS=3600
